<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="APP_NAME" value="${SPRING_APPLICATION_NAME:-notraius}"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>actorId</includeMdcKeyName>
            <includeMdcKeyName>actorType</includeMdcKeyName>
            <fieldNames>
                <timestamp>[ignore]</timestamp>
                <message>message</message>
                <logger>logger_name</logger>
                <thread>thread_name</thread>
            </fieldNames>
            <customFields>{"service":"${APP_NAME}"}</customFields>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_CONSOLE"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>1024</discardingThreshold>
        <neverBlock>false</neverBlock>
    </appender>

    <logger name="com.notraius" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </logger>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>

</configuration>
